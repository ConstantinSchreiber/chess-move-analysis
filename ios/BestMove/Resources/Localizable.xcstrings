        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld casa parece incerta — está destacada no tabuleiro. Toque em uma peça abaixo e depois em uma casa para corrigi-la."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld casas parecem incertas — estão destacadas no tabuleiro. Toque em uma peça abaixo e depois em uma casa para corrigi-la."
                }
              }
