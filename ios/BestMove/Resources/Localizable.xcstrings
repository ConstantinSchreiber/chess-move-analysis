    "Black just moved (%@ → %@), so it's White's turn.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعب الأسود للتو (⁦%@ → %@⁩)، لذا الدور للأبيض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwarz hat gerade gezogen (%@ → %@), also ist Weiß am Zug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Black just moved (%1$@ → %2$@), so it's White's turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las negras acaban de jugar (%@ → %@), así que juegan las blancas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Noirs viennent de jouer (%@ → %@), c’est donc aux Blancs de jouer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitam baru saja melangkah (%@ → %@), jadi giliran Putih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Nero ha appena mosso (%@ → %@), quindi tocca al Bianco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前の手は黒（%@ → %@）なので、白の手番です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwart heeft net gezet (%@ → %@), dus Wit is aan zet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czarne właśnie wykonały ruch (%@ → %@), więc teraz ruch białych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pretas acabaram de jogar (%@ → %@), então é a vez das brancas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чёрные только что сходили (%@ → %@), значит, ход белых."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siyah az önce oynadı (%@ → %@), yani sıra beyazda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чорні щойно зробили хід (%@ → %@), тож тепер хід білих."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑方刚走了一步（%@ → %@），所以轮到白方走棋。"
          }
        }
      }
    },
