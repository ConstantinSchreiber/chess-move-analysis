    "Recognition and analysis run entirely on this device. Photos never leave it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجري التعرّف والتحليل بالكامل على هذا الجهاز. لا تغادر الصور جهازك أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennung und Analyse laufen komplett auf diesem Gerät. Fotos verlassen es nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento y el análisis se realizan por completo en este dispositivo. Las fotos nunca salen de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance et l’analyse ont lieu entièrement sur cet appareil. Les photos ne le quittent jamais."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengenalan dan analisis sepenuhnya berjalan di perangkat ini. Foto tidak pernah keluar dari perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconoscimento e analisi avvengono interamente su questo dispositivo. Le foto non lo lasciano mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識と解析はすべてこのデバイス上で行われます。写真がデバイスの外に送信されることはありません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkenning en analyse gebeuren volledig op dit apparaat. Foto's verlaten het nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie i analiza odbywają się wyłącznie na tym urządzeniu. Zdjęcia nigdy go nie opuszczają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento e a análise acontecem inteiramente neste dispositivo. As fotos nunca saem dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание и анализ выполняются только на этом устройстве. Фото никуда не отправляются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıma ve analiz tamamen bu aygıtta yapılır. Fotoğraflar asla aygıttan çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання й аналіз виконуються лише на цьому пристрої. Фото нікуди не надсилаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别和分析完全在此设备上进行，照片绝不会离开设备。"
          }
        }
      }
    },
