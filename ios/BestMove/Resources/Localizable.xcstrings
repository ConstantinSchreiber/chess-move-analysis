    "Black's king is in check, so it's Black's move.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملك الأسود في حالة كش، لذا الدور للأسود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der schwarze König steht im Schach, also ist Schwarz am Zug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rey negro está en jaque, así que juegan las negras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le roi noir est en échec, c’est donc aux Noirs de jouer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Raja hitam sedang diskak, jadi giliran Hitam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il re nero è sotto scacco, quindi tocca al Nero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黒のキングがチェックされているため、黒の手番です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zwarte koning staat schaak, dus Zwart is aan zet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czarny król jest szachowany, więc ruch mają czarne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rei preto está em xeque, então é a vez das pretas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чёрному королю объявлен шах, значит, ход чёрных."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siyaha şah çekilmiş, yani sıra siyahta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чорному королю оголошено шах, тож хід чорних."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑王正被将军，所以轮到黑方走棋。"
          }
        }
      }
    },
