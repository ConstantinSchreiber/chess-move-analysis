    "White just moved (%@ → %@), so it's Black's turn.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعب الأبيض للتو (⁦%@ → %@⁩)، لذا الدور للأسود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiß hat gerade gezogen (%@ → %@), also ist Schwarz am Zug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "White just moved (%1$@ → %2$@), so it's Black's turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las blancas acaban de jugar (%@ → %@), así que juegan las negras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Blancs viennent de jouer (%@ → %@), c’est donc aux Noirs de jouer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putih baru saja melangkah (%@ → %@), jadi giliran Hitam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Bianco ha appena mosso (%@ → %@), quindi tocca al Nero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前の手は白（%@ → %@）なので、黒の手番です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wit heeft net gezet (%@ → %@), dus Zwart is aan zet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Białe właśnie wykonały ruch (%@ → %@), więc teraz ruch czarnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As brancas acabaram de jogar (%@ → %@), então é a vez das pretas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Белые только что сходили (%@ → %@), значит, ход чёрных."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beyaz az önce oynadı (%@ → %@), yani sıra siyahta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Білі щойно зробили хід (%@ → %@), тож тепер хід чорних."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白方刚走了一步（%@ → %@），所以轮到黑方走棋。"
          }
        }
      }
    },
