    "Pawns can't stand on the first or last rank.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تقف البيادق في الصف الأول أو الأخير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bauern dürfen nicht auf der ersten oder letzten Reihe stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los peones no pueden estar en la primera ni en la última fila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pions ne peuvent pas se trouver sur la première ou la dernière rangée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pion tidak boleh berada di baris pertama atau terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pedoni non possono stare sulla prima o sull'ultima traversa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポーンは第1ランクと最終ランクには置けません。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pionnen mogen niet op de eerste of laatste rij staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Piony nie mogą stać na pierwszej ani ostatniej linii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os peões não podem ficar na primeira nem na última fileira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пешки не могут стоять на первой или последней горизонтали."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piyonlar ilk veya son yatayda duramaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пішаки не можуть стояти на першій або останній горизонталі."
