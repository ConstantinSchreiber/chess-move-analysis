    "%lld squares look uncertain — outlined on the board. Tap a piece below, then a square to fix it.": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld مربعات غير مؤكدة — مُحدَّدة بإطار على الرقعة. اضغط على قطعة بالأسفل، ثم على المربع لتصحيحه."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld مربعًا غير مؤكد — مُحدَّدة بإطار على الرقعة. اضغط على قطعة بالأسفل، ثم على المربع لتصحيحه."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "مربع واحد غير مؤكد — مُحدَّد بإطار على الرقعة. اضغط على قطعة بالأسفل، ثم على المربع لتصحيحه."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld مربع غير مؤكد — مُحدَّدة بإطار على الرقعة. اضغط على قطعة بالأسفل، ثم على المربع لتصحيحه."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "مربعان غير مؤكدَين — مُحدَّدان بإطار على الرقعة. اضغط على قطعة بالأسفل، ثم على المربع لتصحيحه."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Feld wurde nicht sicher erkannt und ist auf dem Brett umrandet. Tippe unten auf eine Figur und dann auf das Feld, um es zu korrigieren."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Felder wurden nicht sicher erkannt und sind auf dem Brett umrandet. Tippe unten auf eine Figur und dann auf ein Feld, um es zu korrigieren."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld square looks uncertain — outlined on the board. Tap a piece below, then a square to fix it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld squares look uncertain — outlined on the board. Tap a piece below, then a square to fix it."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld casilla parece dudosa — está marcada en el tablero. Toca una pieza abajo y luego una casilla para corregirla."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld casillas parecen dudosas — están marcadas en el tablero. Toca una pieza abajo y luego una casilla para corregirla."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld case semble incertaine — elle est entourée sur l’échiquier. Touchez une pièce ci-dessous, puis la case pour la corriger."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld cases semblent incertaines — elles sont entourées sur l’échiquier. Touchez une pièce ci-dessous, puis une case pour la corriger."
                }
              }
            }
          }
        },
        "id": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld petak tampak meragukan — ditandai di papan. Ketuk bidak di bawah, lalu petak untuk memperbaikinya."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld casa sembra incerta — è evidenziata sulla scacchiera. Tocca un pezzo qui sotto, poi una casa per correggerla."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld case sembrano incerte — sono evidenziate sulla scacchiera. Tocca un pezzo qui sotto, poi una casa per correggerla."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lldマスの認識が不確かです（盤上に枠で表示）。下の駒をタップしてから、マスをタップすると修正できます。"
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld veld is niet zeker herkend – het is omlijnd op het bord. Tik hieronder op een stuk en daarna op het veld om het te corrigeren."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld velden zijn niet zeker herkend – ze zijn omlijnd op het bord. Tik hieronder op een stuk en daarna op een veld om het te corrigeren."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld pola są niepewne — zaznaczono je na szachownicy. Wybierz bierkę poniżej, a potem stuknij pole, aby je poprawić."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld pól jest niepewnych — zaznaczono je na szachownicy. Wybierz bierkę poniżej, a potem stuknij pole, aby je poprawić."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld pole jest niepewne — zaznaczono je na szachownicy. Wybierz bierkę poniżej, a potem stuknij pole, aby je poprawić."
