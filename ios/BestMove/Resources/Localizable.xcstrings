    "White's king is in check, so it's White's move.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملك الأبيض في حالة كش، لذا الدور للأبيض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der weiße König steht im Schach, also ist Weiß am Zug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rey blanco está en jaque, así que juegan las blancas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le roi blanc est en échec, c’est donc aux Blancs de jouer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Raja putih sedang diskak, jadi giliran Putih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il re bianco è sotto scacco, quindi tocca al Bianco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白のキングがチェックされているため、白の手番です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De witte koning staat schaak, dus Wit is aan zet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biały król jest szachowany, więc ruch mają białe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rei branco está em xeque, então é a vez das brancas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Белому королю объявлен шах, значит, ход белых."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beyaza şah çekilmiş, yani sıra beyazda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Білому королю оголошено шах, тож хід білих."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白王正被将军，所以轮到白方走棋。"
          }
        }
      }
    },
