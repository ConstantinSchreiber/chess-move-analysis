    "Capture the whole board with all four corners visible — on a monitor, laptop, tablet or in a screenshot.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوِّر الرقعة كاملة مع ظهور زواياها الأربع — على شاشة أو حاسوب محمول أو جهاز لوحي أو في لقطة شاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse das ganze Brett mit allen vier Ecken – auf einem Monitor, Laptop, Tablet oder in einem Bildschirmfoto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura el tablero entero con las cuatro esquinas visibles — en un monitor, portátil, tableta o en una captura de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadrez tout l’échiquier, avec ses quatre coins visibles — sur un écran, un ordinateur portable, une tablette ou dans une capture d’écran."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkap seluruh papan dengan keempat sudutnya terlihat — di monitor, laptop, tablet, atau jepretan layar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadra l'intera scacchiera con tutti e quattro gli angoli visibili — su un monitor, portatile, tablet o in uno screenshot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "四隅がすべて入るように盤面全体を写してください — モニター、ノートパソコン、タブレット、スクリーンショットに対応しています。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg het hele bord vast met alle vier de hoeken in beeld – op een monitor, laptop, tablet of in een schermafbeelding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchwyć całą szachownicę ze wszystkimi czterema rogami — na monitorze, laptopie, tablecie lub zrzucie ekranu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquadre o tabuleiro inteiro com os quatro cantos visíveis — em um monitor, notebook, tablet ou em uma captura de tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимите доску целиком, со всеми четырьмя углами — на мониторе, ноутбуке, планшете или на снимке экрана."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahtanın tamamını dört köşesi de görünecek şekilde çekin — monitörde, dizüstü bilgisayarda, tablette veya ekran görüntüsünde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зніміть дошку повністю, з усіма чотирма кутами — на моніторі, ноутбуці, планшеті чи на знімку екрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍下整个棋盘，确保四个角都在画面内 — 显示器、笔记本电脑、平板电脑或截屏均可。"
          }
        }
      }
    },
