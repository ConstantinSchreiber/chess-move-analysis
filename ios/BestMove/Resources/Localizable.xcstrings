    "Every square read confidently. Still, give the board a quick look against the photo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت قراءة جميع المربعات بثقة. ومع ذلك، ألقِ نظرة سريعة على الرقعة وقارنها بالصورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Felder wurden sicher erkannt. Vergleiche das Brett trotzdem kurz mit dem Foto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las casillas se leyeron con seguridad. Aun así, compara rápidamente el tablero con la foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les cases ont été reconnues avec certitude. Comparez tout de même rapidement l’échiquier avec la photo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua petak terbaca dengan yakin. Meski begitu, cocokkan sekilas papan dengan fotonya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le case sono state lette con sicurezza. Confronta comunque rapidamente la scacchiera con la foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのマスを確実に認識しました。念のため、写真と盤面をざっと見比べてください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle velden zijn met zekerheid herkend. Vergelijk het bord toch even met de foto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie pola rozpoznano pewnie. Mimo to szybko porównaj szachownicę ze zdjęciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as casas foram lidas com segurança. Mesmo assim, compare rapidamente o tabuleiro com a foto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все клетки распознаны уверенно. И всё же быстро сверьте доску с фото."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kareler güvenle okundu. Yine de tahtayı fotoğrafla kısaca karşılaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі клітинки розпізнано впевнено. Та все ж швидко звірте дошку з фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有格子均已准确识别。不过，还是请对照照片快速检查一下棋盘。"
          }
        }
      }
    },
    "Find the best move in any chess position with Best Move: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعثر على أفضل نقلة في أي وضعية شطرنج مع Best Move: %@"
          }
        },
