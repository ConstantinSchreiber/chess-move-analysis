          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld клетки распознаны неуверенно — они обведены на доске. Выберите фигуру ниже, затем коснитесь клетки, чтобы исправить."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld клеток распознаны неуверенно — они обведены на доске. Выберите фигуру ниже, затем коснитесь клетки, чтобы исправить."
