    "Best Move finds the best chess move from a photo of any board.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجد Best Move أفضل نقلة شطرنج من صورة أي رقعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Move findet den besten Schachzug – per Foto von jedem beliebigen Brett."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Move encuentra la mejor jugada de ajedrez a partir de una foto de cualquier tablero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Move trouve le meilleur coup à partir d’une photo de n’importe quel échiquier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Move menemukan langkah catur terbaik dari foto papan apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Move trova la mossa migliore a partire dalla foto di qualsiasi scacchiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Moveは、どんな盤面の写真からでもチェスの最善手を見つけます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Move vindt de beste schaakzet aan de hand van een foto van elk bord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Move znajduje najlepszy ruch szachowy na podstawie zdjęcia dowolnej szachownicy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Best Move encontra o melhor lance de xadrez a partir da foto de qualquer tabuleiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Move находит лучший шахматный ход по фото любой доски."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Move, herhangi bir tahtanın fotoğrafından en iyi satranç hamlesini bulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Move знаходить найкращий шаховий хід за фото будь-якої дошки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Best Move 能根据任意棋盘的照片找出国际象棋的最佳着法。"
          }
        }
      }
    },
    "Best Move is free software, released under the GNU General Public License v3. Its complete source code is available at github.com/ConstantinSchreiber/chess-move-analysis.": {
