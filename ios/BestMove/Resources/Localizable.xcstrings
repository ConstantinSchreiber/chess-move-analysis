    "Keep a right only if that king and rook have never moved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ على الحق فقط إذا لم يتحرك ذلك الملك والرخ أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte ein Recht nur, wenn König und Turm noch nie gezogen haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén un derecho solo si ese rey y esa torre nunca se han movido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne conservez un droit que si ce roi et cette tour n’ont jamais bougé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan hak hanya jika raja dan benteng tersebut belum pernah bergerak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni un diritto solo se quel re e quella torre non si sono mai mossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キングとルークが一度も動いていない場合のみ、権利を残してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat een recht alleen aan als die koning en toren nog nooit hebben bewogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaw prawo tylko wtedy, gdy ten król i ta wieża jeszcze się nie ruszały."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha um direito apenas se esse rei e essa torre nunca tiverem se movido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте право, только если король и эта ладья ещё не ходили."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hakkı yalnızca o şah ve kale hiç oynamadıysa koruyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишайте право, лише якщо король і ця тура ще не ходили."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当对应的王和车都从未移动过时，才保留该易位权。"
          }
        }
      }
    },
