    "Scan any chess board, get the best move. Free on the App Store.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوّر أي رقعة شطرنج واحصل على أفضل نقلة. مجانًا على App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne jedes Schachbrett, erhalte den besten Zug. Kostenlos im App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea cualquier tablero y obtén la mejor jugada. Gratis en el App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez n’importe quel échiquier, obtenez le meilleur coup. Gratuit sur l’App Store."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai papan catur apa pun, dapatkan langkah terbaik. Gratis di App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona qualsiasi scacchiera e scopri la mossa migliore. Gratis su App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんなチェス盤もスキャンして最善手を。App Storeで無料。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan elk schaakbord, krijg de beste zet. Gratis in de App Store."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj dowolną szachownicę i poznaj najlepszy ruch. Za darmo w App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie qualquer tabuleiro e veja o melhor lance. Grátis na App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканируйте любую шахматную доску и узнайте лучший ход. Бесплатно в App Store."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir satranç tahtasını tarayın, en iyi hamleyi görün. App Store'da ücretsiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйте будь-яку шахову дошку й дізнавайтеся найкращий хід. Безкоштовно в App Store."
          }
        },
