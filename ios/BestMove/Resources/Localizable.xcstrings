        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الكاميرا في الإعدادات لتصوير الرقعة، أو اختر لقطة شاشة من الصور بدلًا من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Kamerazugriff in den Einstellungen, um ein Brett zu fotografieren, oder wähle stattdessen ein Bildschirmfoto aus der App „Fotos“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la cámara en Ajustes para fotografiar un tablero, o elige una captura de pantalla de Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à l’appareil photo dans Réglages pour photographier un échiquier, ou choisissez plutôt une capture d’écran dans l’app Photos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses kamera di Pengaturan untuk memotret papan, atau pilih jepretan layar dari Foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso alla fotocamera in Impostazioni per fotografare una scacchiera, oppure scegli uno screenshot da Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盤面を撮影するには「設定」でカメラへのアクセスを許可してください。または「写真」からスクリーンショットを選択してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta cameratoegang toe in Instellingen om een bord te fotograferen, of kies in plaats daarvan een schermafbeelding uit de Foto's-app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na dostęp do aparatu w Ustawieniach, aby sfotografować szachownicę, albo wybierz zrzut ekranu ze Zdjęć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à câmera nos Ajustes para fotografar um tabuleiro ou escolha uma captura de tela no app Fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к камере в Настройках, чтобы сфотографировать доску, или выберите снимок экрана в Фото."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahtanın fotoğrafını çekmek için Ayarlar'da kamera erişimine izin verin veya bunun yerine Fotoğraflar'dan bir ekran görüntüsü seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте доступ до камери в Параметрах, щоб сфотографувати дошку, або виберіть знімок екрана у Фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许访问相机以拍摄棋盘，或改为从“照片”中选择截屏。"
          }
        }
      }
    },
