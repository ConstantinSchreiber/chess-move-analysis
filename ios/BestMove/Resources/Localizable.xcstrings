    "Stockfish 19 runs entirely on this device — no account, no upload, works offline.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل Stockfish 19 بالكامل على هذا الجهاز — بلا حساب، بلا رفع، ويعمل دون اتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish 19 läuft komplett auf diesem Gerät – kein Konto, kein Upload, funktioniert offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish 19 funciona por completo en este dispositivo — sin cuenta, sin subir nada y sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish 19 fonctionne entièrement sur cet appareil — sans compte, sans envoi, même hors ligne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish 19 berjalan sepenuhnya di perangkat ini — tanpa akun, tanpa unggahan, bisa offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish 19 funziona interamente su questo dispositivo — nessun account, nessun caricamento, anche offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish 19はすべてこのデバイス上で動作します — アカウント不要、アップロードなし、オフラインでも使えます。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish 19 draait volledig op dit apparaat – geen account, geen upload, werkt offline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish 19 działa wyłącznie na tym urządzeniu — bez konta, bez wysyłania danych, także offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Stockfish 19 roda inteiramente neste dispositivo — sem conta, sem upload e funciona offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish 19 работает только на этом устройстве — без учётной записи, без отправки данных, даже офлайн."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish 19 tamamen bu aygıtta çalışır — hesap gerekmez, hiçbir şey yüklenmez, çevrimdışı çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish 19 працює лише на цьому пристрої — без облікового запису, без вивантаження даних, навіть офлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish 19 完全在此设备上运行 — 无需账户，无需上传，离线可用。"
          }
        }
      }
    },
