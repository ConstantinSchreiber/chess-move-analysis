    "No chess board found. Make sure all four corners of the board are visible.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على رقعة شطرنج. تأكد من ظهور زوايا الرقعة الأربع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Schachbrett gefunden. Achte darauf, dass alle vier Ecken des Bretts sichtbar sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún tablero. Asegúrate de que se vean las cuatro esquinas del tablero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun échiquier détecté. Assurez-vous que les quatre coins de l’échiquier sont visibles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan catur tidak ditemukan. Pastikan keempat sudut papan terlihat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scacchiera trovata. Assicurati che tutti e quattro gli angoli siano visibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェス盤が見つかりません。盤の四隅がすべて写っていることを確認してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen schaakbord gevonden. Zorg dat alle vier de hoeken van het bord zichtbaar zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono szachownicy. Upewnij się, że widać wszystkie cztery rogi szachownicy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum tabuleiro encontrado. Verifique se os quatro cantos do tabuleiro estão visíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шахматная доска не найдена. Убедитесь, что видны все четыре угла доски."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satranç tahtası bulunamadı. Tahtanın dört köşesinin de göründüğünden emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шахову дошку не знайдено. Переконайтеся, що видно всі чотири кути дошки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到棋盘。请确保棋盘的四个角都在画面内。"
          }
        }
      }
    },
    "No last-move highlight found. Please check who is to move.": {
      "localizations": {
